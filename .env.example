# Copy to ~/.tradeautopsy/station.env (chmod 600). Never commit the filled file.
# GUI launches do not inherit a shell profile; the agent reads this file via StationDotEnv.

# WorkOS AuthKit client id (public). Console's WORKOS_CLIENT_ID is fine:
# same-app device login returns access_token, which Console mints from when
# authkit_authorization_code is absent.
WORKOS_STATION_CLIENT_ID=

# Console origin for device-login mint. Local HTTPS next (`npm run dev` → server.js).
# Production (use www — apex 308-redirects to www):
# TRADEAUTOPSY_SERVER_BASE_URL=https://www.tradeautopsy.in
TRADEAUTOPSY_SERVER_BASE_URL=https://localhost:3000

# S1 desk — public Binance last price into TickBook (no API key, no depth, no Neon).
# Launch the Station app, then: curl -s 'http://127.0.0.1:9137/api/station/quote?instrument=BTCUSDT'
# AGENT_S1_DESK_SYMBOL=BTCUSDT
# AGENT_S1_FRESHNESS_MS=2000

# S2 HistoryBook sqlite — licensed Binance klines coverage (not TickBook, not Yahoo).
# AGENT_HISTORY_DB_PATH=

# Old Bar-only tests: download Zerodha NSE CSV into the agent instrument store.
# Station default is off — do not spawn the Zerodha catalog.
# AGENT_ENABLE_ZERODHA_INSTRUMENTS=1
